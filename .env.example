# DeepSeek report generation
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Runtime defaults
# Use COST, MSFT, COST,MSFT, or ALL.
REPORT_TICKER=ALL
REPORT_TYPE=premarket

# Gmail email delivery
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
EMAIL_TO=

# Optional backup if DeepSeek fails
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gmail email delivery
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
EMAIL_TO=

# Future phases
NOTION_API_KEY=
